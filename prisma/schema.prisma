generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  country   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SponsorInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  country     String?
  amount      String?
  frequency   String?
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        String   @id @default("main")
  ministryName String @default("Papa’s Love Children Ministry")
  campaignManagerName String @default("--------")
  campaignLink String @default("#")
  email     String   @default("papaslovechildrenministry@gmail.com")
  phone     String   @default("+256 774615784")
  alternatePhone String @default("+256709196703")
  location  String   @default("Naama Village, Mityana, Uganda")
  whatsapp  String   @default("")
  instagram String   @default("")
  facebook  String   @default("")
  tiktok    String   @default("")
  youtube  String   @default("")
  threads   String   @default("")
  mtnNumber String @default("+256774615784")
  mtnAccountName String @default("JJUUKO SHAFIC")
  airtelNumber String @default("+256709196703")
  airtelAccountName String @default("JJUUKO SHAFIC")
  equityBankName String @default("Equity Bank Uganda")
  equityAccountName String @default("JJUUKO SHAFIC")
  equityAccountNumber String @default("1016102900637")
  equitySwiftCode String @default("EQBLUGKA")
  equityBranchName String @default("Mityana")
  westernUnionReceiverName String @default("JJUUKO SHAFIC")
  westernUnionCountry String @default("Uganda")
  westernUnionCity String @default("Kampala")
  westernUnionTelephone String @default("+256774615784")
  remitlyRecipientName String @default("JJUUKO SHAFIC")
  remitlyCountry String @default("Uganda")
  remitlyCity String @default("Mityana")
  remitlyTelephone String @default("+256774615784")
  updatedAt DateTime @updatedAt
}

model NewsPost {
 id String @id @default(cuid())
 category String
 title String
 excerpt String @db.Text
 image String
 tag String
 featured Boolean @default(false)
 published Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([published, createdAt])
}

model GalleryPost {
 id String @id @default(cuid())
 src String
 title String
 caption String @db.Text
 category String
 position Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([position, createdAt])
}

model AdminAccount {
  id String @id @default("main")
  email String @unique
  passwordHash String
  updatedAt DateTime @updatedAt
}
