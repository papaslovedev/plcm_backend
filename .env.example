# bcrypt hash of your chosen fixed admin password; generate locally with bcrypt
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_BCRYPT_HASH"
FRONTEND_ORIGIN="https://plcm.up.railway.app"
PORT=4000
